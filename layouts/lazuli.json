{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "preview": "layouts/lazuli.svg",
  "theme": {
    "light": "lazuli-light",
    "dark": "lazuli-dark"
  },
  "ui_font": "Pretendard",
  "floating": [
    {
      "id": "queue",
      "content": {
        "mod": "lazuli",
        "props": {
          "view": "queue"
        }
      },
      "edge": "right",
      "align": "center",
      "peek": 44
    }
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "lazuli",
            "props": {
              "view": "brand"
            }
          }
        },
        {
          "id": "nav",
          "type": "block",
          "size": {
            "weight": 1
          },
          "min": 120,
          "content": {
            "mod": "lazuli",
            "props": {
              "view": "sidebar"
            }
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "lazuli",
            "props": {
              "view": "sidebar",
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "main-area",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "topbar",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "window_drag": true,
              "content": {
                "mod": "tabs"
              }
            },
            {
              "id": "bell",
              "type": "block",
              "size": {
                "px": 52
              },
              "window_drag": true,
              "content": {
                "mod": "lazuli",
                "props": {
                  "view": "bell"
                }
              }
            }
          ]
        },
        {
          "id": "body",
          "type": "row",
          "resizable": false,
          "padding": [
            0,
            8
          ],
          "gap": 8,
          "children": [
            {
              "id": "center",
              "type": "stack",
              "active": "home",
              "padding": 0,
              "children": [
                {
                  "id": "home",
                  "type": "row",
                  "gap": 8,
                  "children": [
                    {
                      "id": "home-board",
                      "type": "block",
                      "content": {
                        "mod": "lazuli",
                        "props": {
                          "view": "home"
                        }
                      },
                      "radius": 10,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "background": "background",
                      "shadow": "sm"
                    },
                    {
                      "id": "home-agent",
                      "type": "column",
                      "hidden": true,
                      "size": {
                        "px": 600
                      },
                      "min": 360,
                      "max": 1100,
                      "padding": [
                        0,
                        0
                      ],
                      "children": [
                        {
                          "id": "home-agent-card",
                          "type": "column",
                          "radius": 10,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "background": "background",
                          "shadow": "sm",
                          "resizable": false,
                          "children": [
                            {
                              "id": "home-agent-head",
                              "type": "block",
                              "size": {
                                "px": 34
                              },
                              "content": {
                                "mod": "lazuli",
                                "props": {
                                  "view": "agent-head",
                                  "place": "home"
                                }
                              }
                            },
                            {
                              "id": "home-agent-term",
                              "type": "block",
                              "content": {
                                "agent": "focused"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "work",
                  "type": "row",
                  "padding": 0,
                  "gap": 8,
                  "children": [
                    {
                      "id": "view",
                      "type": "stack",
                      "active": "main",
                      "children": [
                        {
                          "id": "main",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "gap": 8,
                              "radius": 10,
                              "background": "background",
                              "lone": true,
                              "border": {
                                "width": 1,
                                "color": "border"
                              },
                              "focus": {
                                "width": 1,
                                "color": "accent"
                              },
                              "header": {
                                "content": {
                                  "mod": "lazuli",
                                  "props": {
                                    "view": "pane-head"
                                  }
                                },
                                "height": 30,
                                "position": "top",
                                "reveal": "always"
                              }
                            }
                          }
                        },
                        {
                          "id": "agent",
                          "type": "column",
                          "radius": 10,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "background": "background",
                          "shadow": "sm",
                          "resizable": false,
                          "children": [
                            {
                              "id": "agent-head",
                              "type": "block",
                              "size": {
                                "px": 34
                              },
                              "content": {
                                "mod": "lazuli",
                                "props": {
                                  "view": "agent-head",
                                  "place": "work"
                                }
                              }
                            },
                            {
                              "id": "agent-term",
                              "type": "block",
                              "content": {
                                "agent": "focused"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "panel",
                      "type": "row",
                      "hidden": true,
                      "size": {
                        "px": 420
                      },
                      "min": 280,
                      "max": 900,
                      "radius": 10,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "background": "background",
                      "shadow": "sm",
                      "resizable": false,
                      "children": [
                        {
                          "id": "panel-body",
                          "type": "stack",
                          "active": "files",
                          "children": [
                            {
                              "id": "review",
                              "type": "block",
                              "content": {
                                "mod": "lazuli",
                                "props": {
                                  "view": "review"
                                }
                              }
                            },
                            {
                              "id": "files",
                              "type": "block",
                              "content": {
                                "mod": "lazuli",
                                "props": {
                                  "view": "files"
                                }
                              }
                            },
                            {
                              "id": "changes",
                              "type": "block",
                              "content": {
                                "mod": "changes"
                              }
                            },
                            {
                              "id": "tree",
                              "type": "block",
                              "content": {
                                "mod": "lazuli",
                                "props": {
                                  "view": "tree"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "inbox",
                  "type": "block",
                  "content": {
                    "mod": "lazuli",
                    "props": {
                      "view": "inbox"
                    }
                  },
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "background": "background",
                  "shadow": "sm"
                },
                {
                  "id": "todo",
                  "type": "block",
                  "content": {
                    "mod": "lazuli",
                    "props": {
                      "view": "todo"
                    }
                  },
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "background": "background",
                  "shadow": "sm"
                },
                {
                  "id": "routines",
                  "type": "block",
                  "content": {
                    "mod": "lazuli",
                    "props": {
                      "view": "routines"
                    }
                  },
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "background": "background",
                  "shadow": "sm"
                }
              ]
            },
            {
              "id": "activity",
              "type": "block",
              "size": {
                "px": 44
              },
              "content": {
                "mod": "lazuli",
                "props": {
                  "view": "activity",
                  "stack": "panel-body"
                }
              },
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              },
              "background": "background",
              "shadow": "sm"
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 34
          },
          "content": {
            "mod": "lazuli",
            "props": {
              "view": "status"
            }
          }
        }
      ]
    }
  ]
}
